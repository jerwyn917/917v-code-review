{
  "description": "After installation, offer once to run a 917v-code-review command.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/welcome.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
